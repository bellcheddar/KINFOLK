[Unit]
Description=KINFOLK field guide (gunicorn, read-only atlas)
After=network.target

[Service]
Type=simple
User=kinfolk
Group=www-data
WorkingDirectory=/srv/kinfolk/app
Environment=KINFOLK_DB=/srv/kinfolk/app/data/kinfolk.sqlite
ExecStart=/srv/kinfolk/app/.venv/bin/gunicorn -w 2 --threads 4 -b 127.0.0.1:8010 --access-logfile - kinfolk_app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/srv/kinfolk
PrivateTmp=true

[Install]
WantedBy=multi-user.target
